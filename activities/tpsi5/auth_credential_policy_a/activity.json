  "consegna": "Completa `validateCredentials(input)`. L'input deve essere un oggetto con `email` e `password`. Normalizza l'email con trim + lowercase e verifica un formato email didattico essenziale. La password deve avere da 15 a 128 code point inclusi. Non imporre maiuscole, numeri o simboli. Il programma legge JSON da stdin e stampa un solo JSON deterministico.",
  "vincoli": ["usa const/let e funzioni pure","conta la password con Array.from(password).length","email normalizzata con trim e lowercase","non introdurre regole di composizione","errors nell'ordine: body-invalid, email-invalid, password-too-short, password-too-long","nessun log extra oltre al JSON finale"],
  "assets": [
    {"type":"starter","path":"starter/main.js","target_path":"main.js","visibility":"student","description":"Funzione policy da completare"},
    {"type":"example","path":"student/README.md","target_path":"README.md","visibility":"student","description":"Contratto input/output"},
    {"type":"teacher_only","path":"solution/main.js","visibility":"teacher","description":"Soluzione docente"}
  ],
  "soluzione_attesa": {"tipo":"javascript-deterministico","file":"main.js","note":"Policy pura; nessun hashing in questa Activity."},
