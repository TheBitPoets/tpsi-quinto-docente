  "metriche": {"tempo_stimato_minuti":35,"traccia_tempo_dichiarato":true,"traccia_sessioni_thebitlab":true,"traccia_eventi_didattici":true,"traccia_errori_compilazione":true},
  "test_cases": [
    {"name":"valid-passphrase","stdin":"{\"email\":\"  STUDENTE@Example.Test \",\"password\":\"una passphrase lunga 2026\"}\n","expected_stdout":"{\"ok\":true,\"email\":\"studente@example.test\",\"errors\":[]}"},
    {"name":"short-no-composition","stdin":"{\"email\":\"a@b.test\",\"password\":\"Aa1!breve\"}\n","expected_stdout":"{\"ok\":false,\"email\":\"a@b.test\",\"errors\":[\"password-too-short\"]}"},
    {"name":"invalid-email","stdin":"{\"email\":\"not-an-email\",\"password\":\"questa password supera quindici\"}\n","expected_stdout":"{\"ok\":false,\"email\":\"not-an-email\",\"errors\":[\"email-invalid\"]}"},
    {"name":"body-invalid","stdin":"[]\n","expected_stdout":"{\"ok\":false,\"email\":\"\",\"errors\":[\"body-invalid\"]}"},
    {"name":"too-long","stdin":"{\"email\":\"a@b.test\",\"password\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}\n","expected_stdout":"{\"ok\":false,\"email\":\"a@b.test\",\"errors\":[\"password-too-long\"]}"}
