  "metriche": {"tempo_stimato_minuti":35,"traccia_tempo_dichiarato":true,"traccia_sessioni_thebitlab":true,"traccia_eventi_didattici":true,"traccia_errori_compilazione":true},
  "test_cases": [
    {"name":"anonymous-read","stdin":"{\"user\":null,\"post\":{\"id\":\"p1\",\"authorId\":\"u1\"},\"action\":\"read\"}\n","expected_stdout":"{\"allowed\":false,\"reason\":\"authentication-required\"}"},
    {"name":"authenticated-like","stdin":"{\"user\":{\"id\":\"u2\"},\"post\":{\"id\":\"p1\",\"authorId\":\"u1\"},\"action\":\"like\"}\n","expected_stdout":"{\"allowed\":true,\"reason\":\"allowed\"}"},
    {"name":"owner-delete","stdin":"{\"user\":{\"id\":\"u1\"},\"post\":{\"id\":\"p1\",\"authorId\":\"u1\"},\"action\":\"delete\"}\n","expected_stdout":"{\"allowed\":true,\"reason\":\"allowed\"}"},
    {"name":"non-owner-delete","stdin":"{\"user\":{\"id\":\"u2\"},\"post\":{\"id\":\"p1\",\"authorId\":\"u1\"},\"action\":\"delete\"}\n","expected_stdout":"{\"allowed\":false,\"reason\":\"ownership-required\"}"},
    {"name":"unknown","stdin":"{\"user\":{\"id\":\"u1\"},\"post\":{\"id\":\"p1\",\"authorId\":\"u1\"},\"action\":\"ban\"}\n","expected_stdout":"{\"allowed\":false,\"reason\":\"action-unknown\"}"}
