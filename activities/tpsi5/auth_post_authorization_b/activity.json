  "consegna": "Completa `authorizePostAction(input)`. L'input contiene `user`, `post` e `action`. Un utente non autenticato non puo fare nulla. Un autenticato puo `read`, `like` e `create`. `edit` e `delete` sono consentite solo se `post.authorId === user.id`. Le decisioni devono essere server-side e deterministiche. Stampa `{allowed, reason}`.",
  "vincoli": ["non leggere campi come currentUserId scelti fuori da user.id","edit/delete richiedono ownership","nessun accesso DOM","reason stabile: authentication-required, allowed, ownership-required, action-unknown","nessun log extra"],
  "assets": [
    {"type":"starter","path":"starter/main.js","target_path":"main.js","visibility":"student","description":"Authorization function da completare"},
    {"type":"example","path":"student/README.md","target_path":"README.md","visibility":"student","description":"Matrice access control"},
    {"type":"teacher_only","path":"solution/main.js","visibility":"teacher","description":"Soluzione docente"}
  ],
  "soluzione_attesa": {"tipo":"javascript-deterministico","file":"main.js","note":"Funzione pura di authorization per ownership."},
