{"schema_version":"1.0","id":"tpsi5-activity-d-debug-testing-boundaries-001","titolo":"Debug testing: shared state, order dependency e over-mocking","tipo":"debug-didattico","student_support_mode":"teoria-dispense","difficolta":"D","argomenti":["pytest","debugging","shared-state","test-order","over-mocking","fixture","teardown","observable-contract"],"linguaggio":"python","contesto":{"percorso":"quinto-anno","uda":"uda-26"},"content_ids":["tpsi5-content-testing-integration-boundaries"],"source_refs":[{"source_id":"tpsi5-source-originali","path":"content/tpsi5/17_TESTING_INTEGRATION_BOUNDARIES.md","anchor":"17-over-mocking-test-verde-sistema-rotto","role":"lesson"}],"consegna":"Individua e correggi almeno cinque classi di difetto nei test: stato globale condiviso, dipendenza dall'ordine, over-mocking, assert su dettagli interni, teardown mancante e failure inghiottite. La soluzione deve usare fixture function-scoped/tmp_path e verificare il contratto HTTP osservabile.","vincoli":["nessun shared-test.db","nessun client globale","nessuna dipendenza dall'ordine","nessun MagicMock nel test d'integrazione reference","teardown Engine esplicito","nessun except Exception: pass","assert su status/header/body"],"assets":[{"type":"starter","path":"starter/broken_tests.py","target_path":"broken_tests.py","visibility":"student","description":"Suite fragile"},{"type":"teacher_only","path":"solution/fixed_tests.py","visibility":"teacher","description":"Reference fix"},{"type":"teacher_only","path":"solution/DIAGNOSI.md","visibility":"teacher","description":"Diagnosi"},{"type":"teacher_only","path":"teacher/NOTES.md","visibility":"teacher","description":"Conduzione"}],"soluzione_attesa":{"tipo":"testing-debug-diagnosis","note":"Correzione dei boundary, non solo dei singoli assert."},"correzione":{"compila":false,"test":false,"sandbox":false,"ai_feedback":false},"metriche":{"tempo_stimato_minuti":65,"traccia_tempo_dichiarato":true,"traccia_sessioni_thebitlab":true,"traccia_eventi_didattici":true,"traccia_errori_compilazione":true},"manual_checks":[{"name":"shared","criterion":"rimuove stato/database globali"},{"name":"order","criterion":"test indipendenti dall'ordine"},{"name":"mock","criterion":"non mocka il boundary d'integrazione"},{"name":"contract","criterion":"assert su comportamento osservabile"},{"name":"teardown","criterion":"fixture possiede cleanup"}],"rubrica":[{"criterio":"Shared state","punti":2},{"criterio":"Order independence","punti":2},{"criterio":"Mock boundary","punti":2},{"criterio":"Observable contract","punti":2},{"criterio":"Lifecycle/teardown","punti":2}]}
