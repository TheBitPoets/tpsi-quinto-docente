  "test_cases": [
    {"name": "post valido e trim", "stdin": "{\"text\":\"  Ciao Feisbuc  \"}\n", "expected_stdout": "{\"ok\":true,\"value\":{\"text\":\"Ciao Feisbuc\"}}\n"},
    {"name": "text mancante", "stdin": "{}\n", "expected_stdout": "{\"ok\":false,\"error\":\"text-required\"}\n"},
    {"name": "solo spazi", "stdin": "{\"text\":\"   \"}\n", "expected_stdout": "{\"ok\":false,\"error\":\"text-required\"}\n"},
    {"name": "body array", "stdin": "[]\n", "expected_stdout": "{\"ok\":false,\"error\":\"body-invalid\"}\n"},
    {"name": "text non stringa", "stdin": "{\"text\":42}\n", "expected_stdout": "{\"ok\":false,\"error\":\"text-required\"}\n"},
